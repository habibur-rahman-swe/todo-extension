{
  "manifest_version": 3,
  "name": "Daily Todo",
  "version": "1.0",
  "description": "Daily todo list that opens automatically when the browser starts. Ticks reset each new day.",
  "permissions": ["storage", "windows"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Daily Todo"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}